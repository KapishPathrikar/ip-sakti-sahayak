# ==========================================
# IP Shakti Sahayak - Production Environment
# ==========================================

# 1. CORS Allowed Origins (Comma-separated URLs of your deployed frontend)
# Example: https://ip-shakti-sahayak.vercel.app,http://localhost:3000
CORS_ORIGINS=https://ip-shakti-sahayak.vercel.app,http://localhost:3000

# 2. Database Connection URL (PostgreSQL from Neon.tech or Supabase)
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Google Gemini API Key (Free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Optional: Gemini Model identifier (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 5. Port (Default: 7860 for Hugging Face Spaces, 8000 for local)
PORT=7860

