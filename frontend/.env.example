# =============================================================
# Frontend Environment Configuration (Vercel / Local)
# =============================================================

# For Local Development:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# For Production on Vercel:
# Set this in your Vercel Project Settings -> Environment Variables
# to your live backend URL (e.g. Hugging Face Space URL)
NEXT_PUBLIC_API_BASE_URL=https://<your-hf-username>-ip-shakti-api.hf.space

